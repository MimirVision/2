# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets).
EXPO_PUBLIC_API_URL=https://flipp-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_PRIVACY_URL=https://your-site.example/privacy
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-site.example
